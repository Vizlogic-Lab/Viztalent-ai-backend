# Viztalent backend configuration. Copy to .env (local) or /etc/viztalent/app.env (server)
# and fill in. NEVER commit the filled-in file. scripts/generate-secrets.sh creates one
# with strong random values. Lines starting with # are optional; leave them commented to
# keep the default shown (an empty value would override the default with nothing).

# Spring profile. Server: prod (refuses to start with weak/missing secrets or demo
# accounts). Locally, set SPRING_PROFILES_ACTIVE=dev in your run configuration instead:
# the dev profile is what reads this .env (and seeds demo accounts).
SPRING_PROFILES_ACTIVE=

# ── Required secrets ──────────────────────────────────────────────────────────
# Database password (the docker-compose Postgres is created with it).
DB_PASSWORD=
# JWT signing key: at least 32 bytes of randomness (openssl rand -base64 48).
APP_JWT_SECRET=
# Encrypts secrets saved in Settings (Gemini key, SMTP/Twilio passwords). At least
# 24 characters. Changing it later means re-entering those secrets in Settings.
SETTINGS_ENCRYPTION_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Database location (defaults suit the local docker-compose Postgres on :15433).
# DB_URL=jdbc:postgresql://localhost:15433/smartstaff_classic
# DB_USERNAME=smartstaff_classic

# Override the Gemini key / SMTP password saved in Settings (env wins when set).
# GEMINI_API_KEY=
# SMTP_PASSWORD=

# Gemini model choice (also set at runtime in Settings) and the daily AI call cap.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=
# AI_DAILY_CALL_CAP=2000

# First start of a fresh database only: creates this admin if no admin exists; they
# must change the password at first login. Remove both lines once that's done.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# Allowed browser origins, comma separated (production: https://<your-domain>).
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173
