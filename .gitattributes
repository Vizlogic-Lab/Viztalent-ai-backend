# Normalize line endings to LF for all text files
* text=auto eol=lf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pdf binary

# Documents are text
*.md text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.sql text eol=lf

# Java and source code
*.java text eol=lf
*.gradle text eol=lf
*.groovy text eol=lf
*.sh text eol=lf
